<Window x:Class="PatientManagement.WPF.Views.PatientDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient Details"
        Height="420"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Border Margin="15"
            BorderBrush="Gray"
            BorderThickness="1"
            Padding="15">

        <StackPanel>

            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,20"
                Text="Patient Information"/>

            <TextBlock FontWeight="Bold"
                       Text="Name"/>

            <TextBlock x:Name="txtName"
                       Margin="0,0,0,15"/>

            <TextBlock FontWeight="Bold"
                       Text="Gender"/>

            <TextBlock x:Name="txtGender"
                       Margin="0,0,0,15"/>

            <TextBlock FontWeight="Bold"
                       Text="Birth Date"/>

            <TextBlock x:Name="txtBirthDate"
                       Margin="0,0,0,15"/>

            <TextBlock FontWeight="Bold"
                       Text="Contact Number"/>

            <TextBlock x:Name="txtContact"
                       Margin="0,0,0,15"/>

            <TextBlock FontWeight="Bold"
                       Text="Address"/>

            <TextBlock x:Name="txtAddress"
                       TextWrapping="Wrap"
                       Margin="0,0,0,25"/>

            <Button Width="120"
                    Height="35"
                    HorizontalAlignment="Center"
                    Click="Close_Click">
                Close
            </Button>

        </StackPanel>

    </Border>

</Window>