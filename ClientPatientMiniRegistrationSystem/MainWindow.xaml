<Window x:Class="PatientManagement.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clinic Patient Management"
        Height="550"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">

        <!-- Top Toolbar -->
        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Top"
                    Margin="0,0,0,10">

            <Button x:Name="BtnAdd"
                    Width="100"
                    Margin="5"
                    Click="BtnAdd_Click">
                Add Patient
            </Button>

            <Button x:Name="BtnEdit"
                    Width="100"
                    Margin="5"
                    Click="BtnEdit_Click">
                Edit
            </Button>

            <Button x:Name="BtnDelete"
                    Width="100"
                    Margin="5"
                    Click="BtnDelete_Click">
                Delete
            </Button>

            <Button x:Name="BtnDetails"
                    Width="120"
                    Margin="5"
                    Click="BtnDetails_Click">
                View Details
            </Button>

            <Button x:Name="BtnRefresh"
                    Width="100"
                    Margin="5"
                    Click="BtnRefresh_Click">
                Refresh
            </Button>

        </StackPanel>

        <!-- Bottom -->

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10">

            <Button Width="100"
                    Height="30"
                    Click="BtnLogout_Click">
                Logout
            </Button>

        </StackPanel>

        <!-- Search -->

        <StackPanel Orientation="Horizontal"
            DockPanel.Dock="Top"
            Margin="0,0,0,10">

            <TextBlock Text="🔍"
               FontSize="16"
               VerticalAlignment="Center"
               Margin="0,0,5,0"/>

            <TextBox x:Name="txtSearch"
             Width="300"
             Height="28"
             TextChanged="txtSearch_TextChanged"
             ToolTip="Search by name, gender, contact, address or ID"/>
        </StackPanel>

        <!-- Patient Grid -->

        <DataGrid
            x:Name="PatientsGrid"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn
                Header="ID"
                Binding="{Binding Id}"
                Width="60"/>

                <DataGridTextColumn
                Header="Name"
                Binding="{Binding Name}"
                Width="180"/>

                <DataGridTextColumn
                Header="Gender"
                Binding="{Binding Gender}"
                Width="100"/>

                <DataGridTextColumn
                Header="Birth Date"
                Binding="{Binding BirthDate,StringFormat=d}"
                Width="120"/>

                <DataGridTextColumn
                Header="Contact"
                Binding="{Binding ContactNumber}"
                Width="150"/>

                <DataGridTextColumn
                Header="Address"
                Binding="{Binding Address}"
                Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

        <TextBlock x:Name="txtNoRecords"
           Text="No records found."
           FontSize="16"
           FontWeight="Bold"
           Foreground="Gray"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Visibility="Collapsed"/>


    </DockPanel>

</Window>